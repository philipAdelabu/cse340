<%- include('partials/header') %>
  
    <main>
        <h2>Details of <%= title %></h2>
        
           <% if(project) { %>
         <strong><%= project.title %></strong><br>
        <strong>Date:</strong> <%= (project.date).toLocaleDateString('en-GB') %><br>
        <strong>Location:</strong> <%= project.location %><br>
        <strong>Description:</strong> <%= project.description %><br>
    
        <strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a><br>
              <br>
            <h3>Project Category</h3>
                 <% categories.forEach(category => { %>
                <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
            <% }) %>  
              <% } else { %>
                  Project not found.
                <% } %>
     
      <br><br>
      <% if (user && user.role_name === 'admin') { %>
        <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a> &nbsp;&nbsp;&nbsp;&nbsp; <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
        <% } %>
         
        <br><br><br>
         <% if(isLoggedIn){
                  if(project.isUserVolunteer){ %>
                    <p>You have already volunteered for this project.</p>
                    <a href="/remove-volunteer/<%= project.project_id %>/<%= project.volunteer_id %>" style="color: red;">Remove Volunteer</a>
                  <% } else { %>
                     <a href="/volunteer/<%= project.project_id %>">Volunteer for this project</a>
                  <% } %>
              
           <% } else { %>
           <a href="/login">Login to volunteer for this project</a>
            <% } %>
        


    </main>
<%- include('partials/footer') %>
