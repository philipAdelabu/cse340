<%-  include('partials/header') %>

<main>
   <h1> <%= title %></h1>

    <div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Form Card Wrapper -->
            <div class="shadow-sm border-0 rounded-3">
                <div class="card-body ">
                                
                    <form action="/edit-category/<%= category.category_id %>" method="POST" class="needs-validation">
                        
                        <!-- Row for First & Last Name -->
                        <div class="row g-3 mb-3">
                            <div class="col-sm-12 col-lg-6">
                                <label for="name" class="form-label">Category Name</label>
                                <input type="text" class="form-control" value="<%= category.name %>" id="name" name="name" minLength="3" maxLength="100" required>
                            </div>
                      
                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Update category</button>
                        
                    </form>
                    
                </div>
            </div>
            <!-- End Form Card -->
        </div>
    </div>
</div>


</main>


<%- include('partials/footer') %>