<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

     <div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Form Card Wrapper -->
            <div class="shadow-sm border-0 rounded-3">
                <div class="card-body ml-3">
                                
                    <form action="/new-organization" method="POST"class="needs-validation">
                        
                        <!-- Row for First & Last Name -->
                        <div class="row g-3 mb-3">
                            <div class="col-sm-12 col-lg-6">
                                <label for="name" class="form-label">Organization Name</label>
                                <input type="text" class="form-control" id="name" name="name" maxLength="150" required>
                            </div>
                        </div>

                         <div class="row g-3 mb-3">
                            <div class="col-sm-12 col-lg-6">
                                <label for="description" class="form-label">Description</label>
                                <textarea class="form-control" id="description" name="description" maxLength="500" required></textarea>
                            </div>
                        </div>

                         <div class="row g-3 mb-3">
                            <div class="col-sm-12 col-lg-6">
                                <label for="contactEmail" class="form-label">Contact Email</label>
                                <input type="email" class="form-control" id="contactEmail" maxLength="255" name="contactEmail" required>
                            </div>
                        </div>
                      
                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Create Organization</button>
                        
                    </form>
                    
                </div>
            </div>
            <!-- End Form Card -->
        </div>
    </div>
</div>


</main>
<%- include('partials/footer') %>