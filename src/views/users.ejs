 <%- include('partials/header') %>
  
    <main>
        <h2><%= title %></h2>
        <br>

        <% if(users && users.length === 0) { %>
            <p>No registered users found.</p>
        <% } else { %>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                        <tr>
                            <td><a href="#"><%= user.name %></a></td>
                            <td><%= user.email %></td>
                            <td><%= user.role_name %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>

        <% } %>
            
    
        <br><br>
      
    </main>
<%- include('partials/footer') %>
