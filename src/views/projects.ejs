 <%- include('partials/header') %>
  
    <main>
        <h2><%= title %></h2>

        <% if(projects && projects.length === 0) { %>
            <p>No projects found.</p>
        <% } else { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li><a href="/project/<%= project.project_id %>"><%= project.title %></a> by <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></li>
                <% }); %>
            </ul>

        <% } %>
            
    
        <br><br>
        <% if (user && user.role_name === 'admin') { %>
        <a href="/new-project" class="btn btn-primary">Create New Project</a>
        <% } %>
    </main>
<%- include('partials/footer') %>
