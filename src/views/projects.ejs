 <%- include('partials/header') %>
  
    <main>
        <h1><%= title %></h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
           
            <% projects.forEach(project => { %>
                <li><strong><%= (project.date).toLocaleDateString('en-GB') %></strong>: <%= project.title %> <i>(<%= project.name %>)</i></li>
            <% }); %>
        
        </ul>
    </main>
<%- include('partials/footer') %>
